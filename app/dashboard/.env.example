# Origen absoluto de la API. Vacío usa el mismo origen que el tablero, que es
# lo normal en producción y en desarrollo con el proxy de Vite.
VITE_API_BASE_URL=

# Repositorio público del que cuelgan los documentos enlazados en el banner de
# gobernanza. Vacío usa el repositorio del proyecto. Solo admite HTTPS.
VITE_REPOSITORIO_URL=

# Solo desarrollo: a qué origen reenvía Vite las peticiones de /api.
# Nunca llega al código del navegador.
API_PROXY_TARGET=http://127.0.0.1:8000
