# Configuracion del despliegue. Copiar a .env y ajustar.
# Ningun valor de operacion esta quemado en el codigo: todo lo que cambia entre
# la maquina de un integrante y la instancia de AWS se declara aqui.

# ---------------------------------------------------------------- servicio
# Etiqueta del entorno; aparece en /api/salud para saber contra que se habla.
SATD_ENTORNO=produccion
# Nivel de registro: debug, info, warning, error.
SATD_NIVEL_LOG=info
# Nombre del servicio en la respuesta de salud.
SATD_NOMBRE_SERVICIO=sat-dengue-api

# ------------------------------------------------------------------ datos
# Directorio donde el servicio busca los resultados publicados. Dentro del
# contenedor es un volumen; en local puede ser datos/resultados.
SATD_DIRECTORIO_RESULTADOS=/datos/resultados
# Departamentos servidos, codigos DANE separados por coma. 73 Tolima, 50 Meta.
SATD_DEPARTAMENTOS=50,73

# ---------------------------------------------------------------- frontera
# Origenes autorizados para CORS, separados por coma. No admite comodin.
SATD_ORIGENES_CORS=http://localhost
# Puerto publico que expone el proxy.
PUERTO_PUBLICO=80

# ------------------------------------------------------- almacenamiento S3
# Bucket con los resultados publicados. Vacio desactiva la sincronizacion y el
# servicio usa solo lo que haya en el directorio local.
SATD_BUCKET_S3=
SATD_PREFIJO_S3=resultados/
SATD_SINCRONIZAR_AL_ARRANCAR=true
SATD_ESPERA_S3_SEGUNDOS=20
AWS_DEFAULT_REGION=us-east-1

# --------------------------------------------------------- documentacion
# Publica /api/docs y /api/openapi.json. La interfaz de exploracion carga sus
# recursos desde un CDN publico: apagarla deja el servicio sin esa dependencia.
SATD_EXPONER_DOCS=true

# ------------------------------------------------------------------ cache
# Segundos que el navegador puede reutilizar un resultado publicado. Un
# resultado es inmutable para su par departamento-periodo.
SATD_CACHE_SEGUNDOS=300

# ---------------------------------------------------------------- imagenes
# Etiqueta de las imagenes construidas, util para distinguir despliegues.
VERSION_IMAGEN=local
